# Copy to `.env` next to docker-compose.yml.

# Public hostname pointing at this VM. A free DuckDNS name works
# (https://www.duckdns.org): e.g. myanime.duckdns.org
DOMAIN=

# Your frontend's origin, e.g. https://your-app.web.app — or * while testing.
CORS_ORIGIN=*

# Node heap in MB. 2048 is comfortable on the free ARM VM (24 GB RAM).
NODE_HEAP_MB=2048
